    VALUES (v_user_id, 'Amira Benali Events', 'amira-benali-events', 'Wedding planner — Organisation de mariages et événements sur mesure', 'Wedding planner passionnée avec 7 ans d''expérience. J''organise des mariages et événements inoubliables, du concept à la réalisation. Coordination complète, décoration, gestion des prestataires.', 'https://images.pexels.com/photos/7717254/pexels-photo-7717254.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/33485961/pexels-photo-33485961.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_event, ARRAY['Wedding planner','Coordination événement','Décoration','Gestion prestataires','Design floral'], 7, ARRAY['Français','Arabe','Anglais'], 'Certificat Wedding Planner — EWP Academy', 'Nice', 'Côte d''Azur (60km)', false, '+33 6 67 89 01 23', 'www.amira-benali-events.fr', '1500€ — 8000€', 'available', 'approved', now(), v_admin_id, ARRAY['profil-verifie','reponse-rapide'], 4.9, 11, true, 1567)
    RETURNING id INTO v_provider_id;

