/*
# SERVIO — Seed demo providers with portfolios and reviews

## What this does
Creates 8 demo provider accounts with approved profiles, portfolio items, and reviews.
Each provider has a unique auth user, profile, provider_profile, portfolio items, and some reviews.
This makes the platform immediately usable with realistic content.

## Demo Providers
1. Thomas Laurent — Photographe professionnel (Photographie & Vidéo)
2. Sophie Martin — Coiffeuse-styliste (Beauté & Bien-être)
3. Marc Dubois — Menuisier-ébéniste (Artisanat)
4. Carlo Rossi — Chef à domicile (Restauration)
5. Sarah Chen — Développeuse web (Informatique & Tech)
6. Amira Benali — Wedding planner (Événementiel)
7. Lucas Moreau — Architecte d'intérieur (Design & Créatif)
8. Julia Berg — Coach sportif (Conseil & Coaching)
*/

DO $$
DECLARE
  v_user_id uuid;
  v_provider_id uuid;
  v_cat_photo uuid; v_cat_beaute uuid; v_cat_artisan uuid; v_cat_resto uuid;
  v_cat_info uuid; v_cat_event uuid; v_cat_design uuid; v_cat_coach uuid;
  v_admin_id uuid;
BEGIN
  -- Get category IDs
  SELECT id INTO v_cat_photo FROM public.categories WHERE slug = 'photographie-video';
  SELECT id INTO v_cat_beaute FROM public.categories WHERE slug = 'beaute-bien-etre';
  SELECT id INTO v_cat_artisan FROM public.categories WHERE slug = 'artisanat';
  SELECT id INTO v_cat_resto FROM public.categories WHERE slug = 'restauration';
  SELECT id INTO v_cat_info FROM public.categories WHERE slug = 'informatique-tech';
  SELECT id INTO v_cat_event FROM public.categories WHERE slug = 'evenementiel';
  SELECT id INTO v_cat_design FROM public.categories WHERE slug = 'design-creatif';
  SELECT id INTO v_cat_coach FROM public.categories WHERE slug = 'conseil-coaching';
  SELECT id INTO v_admin_id FROM auth.users WHERE email = 'admin@servio.com';

  -- Helper: create auth user
  -- Provider 1: Thomas Laurent — Photographe
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'thomas.laurent@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'thomas.laurent@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Thomas Laurent","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'thomas.laurent@demo.com'), 'email', now(), now(), now());

    INSERT INTO public.provider_profiles (user_id, business_name, slug, headline, description, avatar_url, banner_url, category_id, skills, experience_years, languages, certifications, city, service_area, remote_service, phone, website, price_range, availability, validation_status, validated_at, validated_by, badges, rating_avg, rating_count, is_featured, profile_views)
    VALUES (v_user_id, 'Thomas Laurent Photography', 'thomas-laurent-photography', 'Photographe professionnel — Portraits, Mariages, Événements', 'Photographe professionnel avec plus de 10 ans d''expérience spécialisé dans les portraits, mariages et événements corporate. Je capture les moments qui comptent avec un œil artistique unique.', 'https://images.pexels.com/photos/37273005/pexels-photo-37273005.png?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/36697538/pexels-photo-36697538.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_photo, ARRAY['Portrait','Mariage','Événementiel','Corporate','Retouche photo'], 10, ARRAY['Français','Anglais'], 'Certificat professionnel de photographie — École Gobelins', 'Paris', 'Île-de-France (75km)', true, '+33 6 12 34 56 78', 'www.thomas-laurent-photo.fr', '80€ — 500€', 'available', 'approved', now(), v_admin_id, ARRAY['profil-verifie','reponse-rapide'], 4.8, 12, true, 1247)
    RETURNING id INTO v_provider_id;

    INSERT INTO public.portfolio_items (provider_id, title, description, photos, category_id, tags, sort_order) VALUES
    (v_provider_id, 'Séance portrait en studio', 'Portrait professionnel en studio avec éclairage dramatique.', ARRAY['https://images.pexels.com/photos/36697247/pexels-photo-36697247.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/36697251/pexels-photo-36697251.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/36697244/pexels-photo-36697244.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_photo, ARRAY['portrait','studio','éclairage'], 1),
    (v_provider_id, 'Photographie de mariage', 'Couple heureux le jour de leur mariage, capturé avec sensibilité.', ARRAY['https://images.pexels.com/photos/3065096/pexels-photo-3065096.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/15507425/pexels-photo-15507425.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_photo, ARRAY['mariage','portrait','cérémonie'], 2),
    (v_provider_id, 'Équipement et setup', 'Mon setup photographique professionnel en studio.', ARRAY['https://images.pexels.com/photos/13699196/pexels-photo-13699196.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/17094508/pexels-photo-17094508.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/8389706/pexels-photo-8389706.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_photo, ARRAY['équipement','studio','technique'], 3);

    INSERT INTO public.reviews (provider_id, author_id, rating, comment, created_at) VALUES
    (v_provider_id, v_admin_id, 5, 'Photos magnifiques pour notre mariage. Thomas a su capturer chaque émotion. Je recommande à 100% !', now() - interval '15 days'),
    (v_provider_id, v_admin_id, 5, 'Très professionnel, à l''écoute et créatif. Les portraits sont superbes.', now() - interval '30 days'),
    (v_provider_id, v_admin_id, 4, 'Bon travail sur nos photos corporate. Délai respecté.', now() - interval '45 days');
  END IF;

  -- Provider 2: Sophie Martin — Coiffeuse
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'sophie.martin@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'sophie.martin@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Sophie Martin","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'sophie.martin@demo.com'), 'email', now(), now(), now());

    INSERT INTO public.provider_profiles (user_id, business_name, slug, headline, description, avatar_url, banner_url, category_id, skills, experience_years, languages, certifications, city, service_area, remote_service, phone, price_range, availability, validation_status, validated_at, validated_by, badges, rating_avg, rating_count, is_featured, profile_views)
    VALUES (v_user_id, 'Sophie Martin — Styliste', 'sophie-martin-styliste', 'Coiffeuse-styliste — Coupes, couleurs, coiffages événementiels', 'Coiffeuse-styliste passionnée avec 8 ans d''expérience. Spécialisée dans les coupes tendance, balayage, et coiffages de mariage. Je me déplace à domicile pour les événements.', 'https://images.pexels.com/photos/7717254/pexels-photo-7717254.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/8834017/pexels-photo-8834017.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_beaute, ARRAY['Coupe','Balayage','Coloration','Coiffage mariage','Extensions'], 8, ARRAY['Français','Espagnol'], 'CAP Coiffure + Brevet Professionnel', 'Lyon', 'Lyon et agglomération (30km)', true, '+33 6 23 45 67 89', '35€ — 120€', 'available', 'approved', now(), v_admin_id, ARRAY['profil-verifie','reponse-rapide','nouveau'], 4.7, 8, false, 856)
    RETURNING id INTO v_provider_id;

    INSERT INTO public.portfolio_items (provider_id, title, description, photos, category_id, tags, sort_order) VALUES
    (v_provider_id, 'Balayage miel', 'Balayage miel sur cheveux bruns, effet naturel et lumineux.', ARRAY['https://images.pexels.com/photos/3993320/pexels-photo-3993320.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/15659494/pexels-photo-15659494.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_beaute, ARRAY['balayage','couleur','cheveux'], 1),
    (v_provider_id, 'Coiffage de mariage', 'Chignon élégant pour mariage avec accessoires décoratifs.', ARRAY['https://images.pexels.com/photos/3065096/pexels-photo-3065096.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/15507425/pexels-photo-15507425.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/3356170/pexels-photo-3356170.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_beaute, ARRAY['mariage','chignon','événement'], 2),
    (v_provider_id, 'Coupe et styling', 'Coupe précise et styling moderne en salon.', ARRAY['https://images.pexels.com/photos/6487888/pexels-photo-6487888.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/7755216/pexels-photo-7755216.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_beaute, ARRAY['coupe','styling','précision'], 3);

    INSERT INTO public.reviews (provider_id, author_id, rating, comment, created_at) VALUES
    (v_provider_id, v_admin_id, 5, 'Sophie a fait un travail exceptionnel sur mes cheveux pour mon mariage. Merci !', now() - interval '10 days'),
    (v_provider_id, v_admin_id, 4, 'Très bon balayage, couleur naturelle comme demandé.', now() - interval '20 days');
  END IF;

  -- Provider 3: Marc Dubois — Menuisier
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'marc.dubois@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'marc.dubois@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Marc Dubois","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'marc.dubois@demo.com'), 'email', now(), now(), now());

    INSERT INTO public.provider_profiles (user_id, business_name, slug, headline, description, avatar_url, banner_url, category_id, skills, experience_years, languages, certifications, city, service_area, remote_service, phone, website, price_range, availability, validation_status, validated_at, validated_by, badges, rating_avg, rating_count, is_featured, profile_views)
    VALUES (v_user_id, 'Atelier Dubois — Menuiserie', 'atelier-dubois-menuiserie', 'Menuisier-ébéniste — Mobilier sur mesure, restauration, agencement', 'Artisan menuisier-ébéniste depuis 15 ans. Je crée du mobilier sur mesure et restaure les meubles anciens. Travail du bois passionné et soigné, dans le respect des traditions.', 'https://images.pexels.com/photos/5308640/pexels-photo-5308640.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/7484154/pexels-photo-7484154.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_artisan, ARRAY['Mobilier sur mesure','Restauration','Agencement','Escaliers','Parquet'], 15, ARRAY['Français'], 'CAP Menuiserie + BT Ébéniste, Compagnon du Devoir', 'Bordeaux', 'Nouvelle-Aquitaine (50km)', false, '+33 6 34 56 78 90', 'www.atelier-dubois.fr', 'Sur devis', 'busy', 'approved', now(), v_admin_id, ARRAY['profil-verifie'], 4.9, 15, true, 2103)
    RETURNING id INTO v_provider_id;

    INSERT INTO public.portfolio_items (provider_id, title, description, photos, category_id, tags, sort_order) VALUES
    (v_provider_id, 'Table en chêne massif', 'Table de repas en chêne massif, fabrication sur mesure.', ARRAY['https://images.pexels.com/photos/313773/pexels-photo-313773.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/37178416/pexels-photo-37178416.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_artisan, ARRAY['chêne','table','sur-mesure'], 1),
    (v_provider_id, 'Atelier et savoir-faire', 'Vue de l''atelier et du travail du bois.', ARRAY['https://images.pexels.com/photos/6790070/pexels-photo-6790070.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/6004890/pexels-photo-6004890.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/8820168/pexels-photo-8820168.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_artisan, ARRAY['atelier','savoir-faire','bois'], 2),
    (v_provider_id, 'Construction extérieure', 'Ouvrages bois en extérieur, terrasse et structures.', ARRAY['https://images.pexels.com/photos/32276743/pexels-photo-32276743.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/8820997/pexels-photo-8820997.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_artisan, ARRAY['extérieur','terrasse','construction'], 3);

    INSERT INTO public.reviews (provider_id, author_id, rating, comment, created_at) VALUES
    (v_provider_id, v_admin_id, 5, 'Table magnifique, travail d''artisanat exceptionnel. Marc est un véritable professionnel.', now() - interval '5 days'),
    (v_provider_id, v_admin_id, 5, 'Restauration parfaite de mon buffet de famille. Je suis ravi.', now() - interval '25 days'),
    (v_provider_id, v_admin_id, 4, 'Bon travail mais délai un peu long. La qualité vaut l''attente cependant.', now() - interval '60 days');
  END IF;

  -- Provider 4: Carlo Rossi — Chef
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'carlo.rossi@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'carlo.rossi@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Carlo Rossi","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'carlo.rossi@demo.com'), 'email', now(), now(), now());

    INSERT INTO public.provider_profiles (user_id, business_name, slug, headline, description, avatar_url, banner_url, category_id, skills, experience_years, languages, certifications, city, service_area, remote_service, phone, price_range, availability, validation_status, validated_at, validated_by, badges, rating_avg, rating_count, is_featured, profile_views)
    VALUES (v_user_id, 'Carlo Rossi — Chef à domicile', 'carlo-rossi-chef-a-domicile', 'Chef italien à domicile — Cuisine méditerranéenne, traiteur événementiel', 'Chef d''origine italienne avec 12 ans d''expérience en gastronomie. Je propose des services de chef à domicile, traiteur pour événements et ateliers culinaires. Cuisine méditerranéenne et italienne authentique.', 'https://images.pexels.com/photos/5197205/pexels-photo-5197205.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/17318176/pexels-photo-17318176.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_resto, ARRAY['Chef à domicile','Traiteur','Cuisine italienne','Ateliers culinaires','Pâtes fraîches'], 12, ARRAY['Italien','Français','Anglais'], 'Diplôme de l''Institut Culinaire Italien', 'Marseille', 'Paca (40km)', true, '+33 6 45 67 89 01', '50€ — 150€/personne', 'available', 'approved', now(), v_admin_id, ARRAY['profil-verifie','reponse-rapide'], 4.8, 10, false, 689)
    RETURNING id INTO v_provider_id;

    INSERT INTO public.portfolio_items (provider_id, title, description, photos, category_id, tags, sort_order) VALUES
    (v_provider_id, 'Dîner gastronomique', 'Menu dégustation servi lors d''un dîner privé.', ARRAY['https://images.pexels.com/photos/2977514/pexels-photo-2977514.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/2977515/pexels-photo-2977515.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_resto, ARRAY['gastronomie','dîner','privé'], 1),
    (v_provider_id, 'En cuisine', 'Préparation et dressage des plats.', ARRAY['https://images.pexels.com/photos/4253300/pexels-photo-4253300.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/15671373/pexels-photo-15671373.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/12193823/pexels-photo-12193823.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_resto, ARRAY['cuisine','préparation','dressage'], 2),
    (v_provider_id, 'Plat signature', 'Plat signature du chef — risotto aux cèpes.', ARRAY['https://images.pexels.com/photos/15689896/pexels-photo-15689896.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/34222610/pexels-photo-34222610.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_resto, ARRAY['plat','risotto','signature'], 3);

    INSERT INTO public.reviews (provider_id, author_id, rating, comment, created_at) VALUES
    (v_provider_id, v_admin_id, 5, 'Un dîner inoubliable ! Carlo a transformé notre soirée en moment gastronomique.', now() - interval '8 days'),
    (v_provider_id, v_admin_id, 4, 'Très bon traiteur pour notre événement de 30 personnes. Ravis.', now() - interval '35 days');
  END IF;

  -- Provider 5: Sarah Chen — Développeuse web
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'sarah.chen@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'sarah.chen@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Sarah Chen","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'sarah.chen@demo.com'), 'email', now(), now(), now());

    INSERT INTO public.provider_profiles (user_id, business_name, slug, headline, description, avatar_url, banner_url, category_id, skills, experience_years, languages, certifications, city, service_area, remote_service, phone, website, price_range, availability, validation_status, validated_at, validated_by, badges, rating_avg, rating_count, is_featured, profile_views)
    VALUES (v_user_id, 'Sarah Chen — Dev Web', 'sarah-chen-dev-web', 'Développeuse web full-stack — Sites sur mesure, e-commerce, applications', 'Développeuse web full-stack freelance avec 6 ans d''expérience. Spécialisée en React, Node.js et solutions e-commerce. Je crée des sites modernes, performants et responsive. Disponible en remote.', 'https://images.pexels.com/photos/33680700/pexels-photo-33680700.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', 'https://images.pexels.com/photos/7988114/pexels-photo-7988114.jpeg?auto=compress&cs=tinysrgb&h=650&w=940', v_cat_info, ARRAY['React','Node.js','TypeScript','E-commerce','Next.js','API REST'], 6, ARRAY['Français','Anglais','Chinois'], 'Master Informatique — EPFL, AWS Certified', 'Lille', 'France entière', true, '+33 6 56 78 90 12', 'www.sarahchen.dev', '400€ — 5000€', 'available', 'approved', now(), v_admin_id, ARRAY['profil-verifie','reponse-rapide'], 5.0, 7, false, 432)
    RETURNING id INTO v_provider_id;

    INSERT INTO public.portfolio_items (provider_id, title, description, photos, category_id, tags, sort_order) VALUES
    (v_provider_id, 'Refonte e-commerce', 'Refonte complète d''un site e-commerce avec React et Stripe.', ARRAY['https://images.pexels.com/photos/574077/pexels-photo-574077.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/574071/pexels-photo-574071.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_info, ARRAY['react','e-commerce','stripe'], 1),
    (v_provider_id, 'Application web', 'Développement d''une application web full-stack.', ARRAY['https://images.pexels.com/photos/4974912/pexels-photo-4974912.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/574069/pexels-photo-574069.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_info, ARRAY['web-app','full-stack','typescript'], 2),
    (v_provider_id, 'Workflow et code', 'Environnement de développement et bonnes pratiques.', ARRAY['https://images.pexels.com/photos/12662875/pexels-photo-12662875.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/574080/pexels-photo-574080.jpeg?auto=compress&cs=tinysrgb&h=650&w=940','https://images.pexels.com/photos/37880101/pexels-photo-37880101.jpeg?auto=compress&cs=tinysrgb&h=650&w=940'], v_cat_info, ARRAY['workflow','code','dev'], 3);

    INSERT INTO public.reviews (provider_id, author_id, rating, comment, created_at) VALUES
    (v_provider_id, v_admin_id, 5, 'Sarah a livré un site exceptionnel. Communication parfaite, délais respectés. Je recommande.', now() - interval '12 days'),
    (v_provider_id, v_admin_id, 5, 'Travail impeccable sur notre application. Code propre et bien documenté.', now() - interval '40 days');
  END IF;

  -- Provider 6: Amira Benali — Wedding planner
  IF NOT EXISTS (SELECT 1 FROM auth.users WHERE email = 'amira.benali@demo.com') THEN
    v_user_id := gen_random_uuid();
    INSERT INTO auth.users (id, instance_id, email, encrypted_password, email_confirmed_at, created_at, updated_at, aud, role, raw_app_meta_data, raw_user_meta_data)
    VALUES (v_user_id, '00000000-0000-0000-0000-000000000000', 'amira.benali@demo.com', crypt('demo123456', gen_salt('bf')), now(), now(), now(), 'authenticated', 'authenticated', '{"role":"provider"}'::jsonb, '{"full_name":"Amira Benali","role":"provider"}'::jsonb);
    INSERT INTO auth.identities (provider_id, user_id, identity_data, provider, last_sign_in_at, created_at, updated_at)
    VALUES (v_user_id::text, v_user_id, jsonb_build_object('sub', v_user_id::text, 'email', 'amira.benali@demo.com'), 'email', now(), now(), now());

