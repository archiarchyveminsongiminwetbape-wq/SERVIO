# Production Environment Variables for SERVIO
# Copy this file to .env.production and fill in your production values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY=your-production-public-key
FLUTTERWAVE_SECRET_KEY=your-production-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-production-encryption-key

# Application Configuration
APP_URL=https://your-production-domain.com

# Feature Flags
NODE_ENV=production
ENABLE_ANALYTICS=true
ENABLE_ERROR_TRACKING=true

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Security
SECURE_COOKIES=true
CSRF_PROTECTION=true
XSS_PROTECTION=true

# Email Configuration (if using custom email service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@servio.com

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn
LOGROCKET_APP_ID=your-logrocket-id

# API Keys (if using external services)
HUGGINGFACE_API_KEY=your-huggingface-key
OPENAI_API_KEY=your-openai-key (optional)

# Storage
SUPABASE_STORAGE_BUCKET=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf