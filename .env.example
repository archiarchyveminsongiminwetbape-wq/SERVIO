# ==========================================
# CONFIGURATION SUPABASE
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# CONFIGURATION FLUTTERWAVE (Orange Money)
# ==========================================
# Obtenez ces clés sur https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-XXXXXXXXXXXXXXXXXXXXXXXXXXXXX-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# CONFIGURATION DES NOTIFICATIONS
# ==========================================
# Pour l'envoi d'emails (Resend, SendGrid, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Pour l'envoi SMS (Orange SMS, Twilio, etc.)
ORANGE_SMS_API_KEY=your-orange-sms-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ==========================================
# CONFIGURATION DE L'APPLICATION
# ==========================================
VITE_APP_NAME=SERVIO
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api

# ==========================================
# CONFIGURATION ORANGE MONEY SPÉCIFIQUE
# ==========================================
# Pays supportés par Orange Money
VITE_ORANGE_MONEY_DEFAULT_COUNTRY=CM
VITE_ORANGE_MONEY_CURRENCY=XAF

# ==========================================
# LIMITES ET CONFIGURATIONS
# ==========================================
# Taille maximale des fichiers upload (en bytes)
VITE_MAX_FILE_SIZE=10485760  # 10MB

# Montant minimum de transfert (en XAF)
VITE_MIN_TRANSFER_AMOUNT=1000

# Montant maximum de transfert (en XAF)
VITE_MAX_TRANSFER_AMOUNT=5000000

# ==========================================
# ENVIRONNEMENT
# ==========================================
NODE_ENV=development